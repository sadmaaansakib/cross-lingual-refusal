# Normalize line endings
* text=auto

# Force LF for Python and YAML (platform-independent)
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Binary files — do not touch line endings
*.npy binary
*.png binary
*.pdf binary
*.bin binary
*.safetensors binary
